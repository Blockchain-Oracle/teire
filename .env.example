# Copy to .env.local and fill in. Never commit real values.

# --- Otari (every model call, web search and fetch; docs/otari-setup.md) ---
# The service runs on a service key: its end users carry each person's and installation's daily
# allowance. An ordinary key (the CLI, local dev) works too; it names no end user.
OTARI_SERVICE_KEY=
OTARI_API_KEY=
# OTARI_BASE_URL=https://api.otari.ai/api/v1
# Ask Teire's docs mode names Teire's MCP server and Context7 on Otari once the workspace lets requests
# name MCP servers by URL (docs/otari-setup.md step 5).
# TEIRE_MCP=on
# Teire's prompt-injection guardrail service, which Otari calls; defaults to <TEIRE_PUBLIC_URL>/api/guardrails, `off` turns it off.
# TEIRE_GUARDRAIL_URL=
# Each role's model; unset uses the defaults in packages/engine/src/constants.ts (ROLE_DEFAULTS).
# A value can be a catalog id (vendor/model), a provider:model selector, or a routing-policy name.
# TEIRE_MODEL_FIXER=z-ai/glm-5.3
# TEIRE_MODEL_REVIEWER=deepseek/deepseek-v4-pro-0813
# TEIRE_MODEL_READER=deepseek/deepseek-v4.1-flash-1017
# TEIRE_MODEL_RESEARCHER=minimax/minimax-m3
# TEIRE_MODEL_ASSISTANT=openai/gpt-oss-120b

# --- Verification sandbox (apps/sandbox, deployed to Cloudflare Containers with wrangler) ---
# The Worker's URL, and the key it was given with `wrangler secret put TEIRE_SANDBOX_KEY`.
TEIRE_SANDBOX_URL=
TEIRE_SANDBOX_KEY=

# --- Docs ---
CONTEXT7_API_KEY=

# --- Database ---
# postgres://user:password@host:port/teire — no sslmode in the URL (it would override the CA below).
# Locally: a Postgres 17 on localhost needs no CA. Deployed: TLS only, verified against the CA.
DATABASE_URL=
DATABASE_CA_CERT=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
REVALIDATE_SECRET=
# Where the worker links runs from PRs and comments, and asks the web app to refresh its cache.
TEIRE_WEB_URL=http://localhost:3000

# --- Limits ---
# Money limits live on Otari: each person and installation is an end user of the service key, on
# the budgets in docs/otari-setup.md. Teire's operators (numeric GitHub account ids) see and manage them.
TEIRE_OPERATOR_GITHUB_IDS=

# The resolver service on the Coolify host (apps/resolver/host): dependabot-core's updater under gVisor.
# URL is the Coolify network's gateway address; the secret is in /etc/teire-resolver/env on the host.
TEIRE_RESOLVER_URL=
TEIRE_RESOLVER_SECRET=
# Ecosystems whose dependency files the updater decides (comma-separated: npm,pypi,go,cargo,rubygems,maven).
# For them a stop is final and an unreachable updater queues; the rest use Teire's own edits.
TEIRE_RESOLVER_ECOSYSTEMS=
# R2 package cache for Cloudflare runs (R21.11): set to `on` once the sandbox Worker has its
# `DEP_CACHE` R2 bucket (apps/sandbox/wrangler.jsonc); off, no run saves or restores a cache.
TEIRE_DEP_CACHE=
